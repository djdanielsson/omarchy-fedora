#!/usr/bin/env bash
# First-boot only (see omarchy-firstboot-flatpak.service): Flathub + Bitwarden
# + LocalSend. Retried every boot until it succeeds (done-file gates it).
# 2026-09-12 fix: boot races network-online (DNS not ready) — retry remote-add
# a few times instead of failing the whole unit on first transient error.
set -uo pipefail

export PATH=/usr/sbin:/usr/bin:/sbin:/bin

for attempt in 1 2 3 4 5; do
  if flatpak remote-add --if-not-exists flathub https://dl.flathub.org/repo/flathub.flatpakrepo; then
    break
  fi
  echo "omarchy-firstboot-flatpak: flathub remote-add attempt $attempt failed, retrying..." >&2
  sleep $((attempt * 5))
  [[ $attempt -eq 5 ]] && exit 1
done
flatpak install -y --system flathub com.bitwarden.desktop || exit 1
flatpak install -y --system flathub org.localsend.localsend_app || exit 1
flatpak install -y --system flathub org.mozilla.firefox || exit 1
# LocalSend sandbox can only see xdg-download, which fails to mount on Atomic
# (/home -> /var/home symlink); without this, receives log to history but the
# save silently fails. Live-verified with the explicit path; image uses `home`
# so it works for any install username.
flatpak override --system org.localsend.localsend_app --filesystem=home || true
# Firefox: sandbox to Downloads only
flatpak override --system org.mozilla.firefox --nofilesystem=host --nofilesystem=home --filesystem=xdg-download:ro --filesystem=xdg-download || true

mkdir -p /var/lib
touch /var/lib/.omarchy-firstboot-flatpak-done
