#!/bin/bash
# omarchy:summary=Launch the Omarchy screensaver (Fedora stub)
# Upstream needs Alacritty/Foot/Ghostty/Kitty with a dedicated screensaver
# binary; this image ships Warp-only, so there is no producer for the
# org.omarchy.screensaver window the shell idle service watches for.
# Exit 1 so the idle cycle falls through to omarchy-system-lock at the lock
# timeout instead of logging process-start with no window. Replace with the
# full upstream launcher if a supported terminal is ever added.
exit 1
