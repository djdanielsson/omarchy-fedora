#%PAM-1.0
# Omarchy screen lock (quickshell PamContext "omarchy-lock-password").
# Without this file the shell refuses to lock ("missing-pam") — verified
# 2026-09-12: `omarchy-shell lock lock` returned missing-pam until added.
# Mirrors swaylock on Fedora: password auth via system-auth.
auth include system-auth
account include system-auth
password include system-auth
session include system-auth
